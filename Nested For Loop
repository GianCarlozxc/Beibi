
using System;

class Program
{
    static void Main(string[] args)
    {
        Console.Write("Enter a number: ");
        int number = int.Parse(Console.ReadLine()!);

        Console.WriteLine("\nCounting from 1 to " + number + ":");

        for (int i = 1; i <= number; i++)
        {
            Console.WriteLine("Count: " + i);
        }

    }
}
