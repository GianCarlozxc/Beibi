
using System;

class Program
{
    static void Main()
    {
        string again;

        do
        {
            Console.Write("STUDENT NAME: ");
            string studentName = Console.ReadLine();

            Console.Write("STUDENT NO.: ");
            string studentNo = Console.ReadLine();

            Console.Write("SECTION: ");
            string section = Console.ReadLine();

            Console.Write("DAY OF RESERVATION: ");
            string day = Console.ReadLine();

            Console.Write("TIME OF RESERVATION: ");
            string time = Console.ReadLine();

            Console.Write("PROFS NAME: ");
            string profName = Console.ReadLine();

            Console.Write("SUBJECT CODE: ");
            string subjectCode = Console.ReadLine();

            Console.WriteLine();

            Console.WriteLine("LABORATORY ROOM TO SERVE");
            Console.WriteLine("1. ROOM 207, 209, 211");
            Console.WriteLine("2. CHEM LAB 201");
            Console.WriteLine("3. PHYSICS LAB 203");
            Console.WriteLine("4. DIGITAL LAB 202");

            Console.Write("Select Laboratory Room (1-4): ");
            int choice = Convert.ToInt32(Console.ReadLine());

            if (choice == 1)
            {
                Console.WriteLine("AVAILABLE COMPUTER ROOMS");
                Console.WriteLine("1. ROOM 207");
                Console.WriteLine("2. ROOM 209");
                Console.WriteLine("3. ROOM 211");

                Console.Write("Select Room (1-3): ");
                int roomChoice = Convert.ToInt32(Console.ReadLine());

                if (roomChoice == 1)
                {
                    Console.WriteLine("Selected: ROOM 207");
                }
                else
                {
                    if (roomChoice == 2)
                    {
                        Console.WriteLine("Selected: ROOM 209");
                    }
                    else
                    {
                        if (roomChoice == 3)
                        {
                            Console.WriteLine("Selected: ROOM 211");
                        }
                        else
                        {
                            Console.WriteLine("Invalid room selection!");
                        }
                    }
                }
            }
            else
            {
                if (choice == 2)
                {
                    Console.WriteLine("CHEM LAB 201");
                }
                else
                {
                    if (choice == 3)
                    {
                        Console.WriteLine("PHYSICS LAB 203");
                    }
                    else
                    {
                        if (choice == 4)
                        {
                            Console.WriteLine("DIGITAL LAB 202");
                        }
                        else
                        {
                            Console.WriteLine("Invalid laboratory room!");
                        }
                    }
                }
            }

            Console.WriteLine();
            Console.Write("ANOTHER RESERVATION? (Y/N): ");
            again = Console.ReadLine().ToUpper();

            Console.WriteLine();

        } while (again == "Y");

        Console.WriteLine("THE LABORATORY RESERVATION SYSTEM EXIT");
    }
}
